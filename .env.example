# ==============================================================================
# GODT REGIONAL 3 — CONFIGURACIÓN DE VARIABLES DE ENTORNO (FRONTEND)
# ==============================================================================
# ADVERTENCIA: Las variables con prefijo VITE_ son compiladas en el bundle del
# navegador y son PÚBLICAS. NUNCA coloque contraseñas, secretos ni llaves privadas aquí.

# ------------------------------------------------------------------------------
# 1. RUTA BASE DE LA API
# ------------------------------------------------------------------------------
# En producción suele ser '/api/v1' detrás de un reverse proxy (ej. Nginx),
# o la URL completa de la API (ej. https://api.godt.salud.gov.co/api/v1).
VITE_API_BASE_URL=/api/v1

# ------------------------------------------------------------------------------
# 2. PROXY DE DESARROLLO LOCAL (VITE DEV SERVER)
# ------------------------------------------------------------------------------
# Utilizado exclusivamente por el servidor de desarrollo de Vite para reenviar peticiones.
# En producción este parámetro no tiene efecto (la gestión la hace el servidor web).
VITE_API_PROXY_TARGET=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. METADATOS INSTITUCIONALES DEL PILOTO
# ------------------------------------------------------------------------------
VITE_APP_TITLE=GODT Regional 3 — Gestión Operativa de Donación y Trasplantes
VITE_APP_VERSION=1.0.0-fase-f
VITE_ENVIRONMENT=development
